# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Supabase transaction pooler, port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# DIRECT_URL: Optional direct/session PostgreSQL connection string used by CI migrations (falls back to DATABASE_URL).
DIRECT_URL=""

# NEXT_PUBLIC_MANAGER_WHATSAPP: Manager WhatsApp phone number with country code (digits only, e.g. 2290197000000).
NEXT_PUBLIC_MANAGER_WHATSAPP="2290100000000"

# BETTER_AUTH_SECRET: Random 32+ character secret used to sign Better Auth sessions.
BETTER_AUTH_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET"

# BETTER_AUTH_URL: Canonical base URL of the app (falls back to APP_URL if omitted).
BETTER_AUTH_URL="http://localhost:3000"

# ADMIN_SETUP_TOKEN: One-time secret token required to create the single manager admin account via POST /api/admin/setup.
ADMIN_SETUP_TOKEN="REPLACE_WITH_ONE_TIME_SETUP_TOKEN"

# FEEXPAY_API_KEY: Secret server-only FeexPay API key (Clé privée in Développeurs: test_key_... for Sandbox or live key). NEVER prefix with NEXT_PUBLIC_.
FEEXPAY_API_KEY=""

# FEEXPAY_WEBHOOK_SECRET: Secret HMAC or custom Bearer token configured in FeexPay Webhooks for /api/webhooks/payment.
FEEXPAY_WEBHOOK_SECRET=""

# FEEXPAY_MODE: SANDBOX or LIVE (defaults to SANDBOX).
FEEXPAY_MODE="SANDBOX"

# NEXT_PUBLIC_FEEXPAY_SHOP_ID: Shop ID shown inside the FeexPay Tableau de bord (e.g. xSgF8Ckt6nPXSDp).
NEXT_PUBLIC_FEEXPAY_SHOP_ID=""

# NEXT_PUBLIC_FEEXPAY_MODE: SANDBOX or LIVE (defaults to SANDBOX).
NEXT_PUBLIC_FEEXPAY_MODE="SANDBOX"

